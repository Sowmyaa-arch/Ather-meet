# =================================================================
# AetherMeet - Environment Variables Configuration
# =================================================================

# Server Port and Node Environment
PORT=5000
NODE_ENV=development

# Database Configuration
# Local SQLite default (Zero-config out of the box):
DATABASE_URL=file:./dev.db
# PostgreSQL (for Docker or production):
# DATABASE_URL=postgresql://aethermeet:your_password@localhost:5432/aethermeet_db?schema=public

# Security & Authentication
# Replace with a cryptographically secure random string (minimum 32 characters)
JWT_SECRET=aethermeet_jwt_secret_dev_key_min_32_characters_123456789
JWT_EXPIRES_IN=7d

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173

# WebRTC ICE Servers Configuration (STUN & TURN)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302

# Optional TURN server for symmetric NAT traversal in restricted networks
# TURN_SERVER_URL=turn:turn.yourdomain.com:3478
# TURN_USERNAME=turn_user
# TURN_CREDENTIAL=turn_password

# Optional Redis for horizontal multi-server Socket.IO scaling
# If unset, the server automatically uses the high-performance in-memory adapter
# REDIS_URL=redis://localhost:6379
