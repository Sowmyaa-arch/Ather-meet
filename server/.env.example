# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=file:./dev.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webrtc_db?schema=public

# Security & Authentication
JWT_SECRET=aethermeet_super_secret_jwt_key_randomized_min_32_chars_123456
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173

# =============================================================================
# WebRTC TURN Server — Metered.ca (Recommended, Free 50GB/month)
# =============================================================================
# Steps:
#   1. Sign up at https://www.metered.ca/  (free account)
#   2. Go to Dashboard → TURN Credentials → Create App
#   3. Copy your App Name (becomes METERED_DOMAIN) and API Key (METERED_API_KEY)
#   4. Set these on Render under Environment Variables
#
# METERED_DOMAIN is in the form:  <your-app-name>.metered.live
# METERED_API_KEY is the secret key shown in the Metered dashboard
#
METERED_API_KEY=your_metered_api_key_here
METERED_DOMAIN=your-app-name.metered.live

# =============================================================================
# WebRTC TURN Server — Static Credentials (Alternative / Backup)
# =============================================================================
# Only needed if you are self-hosting a coturn server.
# Leave blank if using Metered.ca above.
#
# TURN_SERVER_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=your_turn_username
# TURN_CREDENTIAL=your_turn_password

# Redis Configuration (Optional for multi-instance scaling; in-memory fallback used if unset)
# REDIS_URL=redis://localhost:6379
